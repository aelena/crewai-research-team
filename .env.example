# Copy to .env and fill in. Every value here has a default except the API keys.

# --- Models (LiteLLM / CrewAI model strings: provider/model) -------------------
# "fast" agents do the tool-heavy work (search, scrape, verify); "strong" agents plan, synthesise and write.
# Anthropic list prices per 1M tokens, input/output: Opus 5.5 $4/$20, Sonnet 5.5 $2/$10, Haiku 4.5 $1/$5.
#
# Quality profile (the defaults):
RESEARCH_LLM_FAST=anthropic/claude-sonnet-5-5
RESEARCH_LLM_STRONG=anthropic/claude-opus-5-5
#
# Budget profile: roughly half the cost per token, Opus kept only for the prose a reader sees.
# RESEARCH_LLM_FAST=anthropic/claude-haiku-4-5
# RESEARCH_LLM_STRONG=anthropic/claude-sonnet-5-5
# RESEARCH_LLM_COLUMNIST=anthropic/claude-opus-5-5
#
# Per-agent override, RESEARCH_LLM_<AGENT_KEY> (agents: research_planner, topic_researcher,
# contrarian_researcher, fact_checker, research_analyst, report_writer, columnist, editorial_board), e.g.:
# RESEARCH_LLM_FACT_CHECKER=anthropic/claude-sonnet-5-5   # if Haiku's verdicts look careless
# RESEARCH_LLM_TOPIC_RESEARCHER=openai/gpt-5-mini
# RESEARCH_LLM_TEMPERATURE=0.3

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Web search: exa | serper | tavily | brave | none (auto picks the first key present) ---
RESEARCH_SEARCH_PROVIDER=auto
EXA_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Behaviour ---------------------------------------------------------------
RESEARCH_VERBOSE=true
RESEARCH_MAX_RPM=60
RESEARCH_RUNS_DIR=runs
# Crew memory and knowledge/ need an embedder (OpenAI by default in CrewAI).
RESEARCH_MEMORY=false
RESEARCH_KNOWLEDGE=false

# --- Cost controls ---------------------------------------------------------------
# Tool-using agents resend their whole conversation, scraped pages included, on every step:
# cost grows with (result size x steps). These two caps bound it. Every run records tokens and a
# list-price estimate in runs/<run_id>/status.json "usage" (prices: src/research_team/config/prices.yaml).
#
# Characters of one search/scrape result the agent sees; the rest is cut (and its URLs not recorded).
# 0 = no cap.
RESEARCH_TOOL_MAX_CHARS=12000
# Max reasoning/tool steps per researcher and fact checker. Lower = cheaper and shallower.
RESEARCH_AGENT_MAX_ITER=12

# --- Reuse earlier work instead of paying for it again ------------------------------
# none   : run everything (default)
# plan     : skip planning, reuse an earlier run's research plan (stage report or article)
# research : also skip the three research tracks (tasks 1-4), resume at the source audit;
#            the way back from a run that stopped mid-verification (credit, rate limit)
# report   : skip all research (tasks 1-9) and only draft, review, revise (stage article)
# The --reuse / --reuse-from CLI flags override these per run.
RESEARCH_REUSE=none
# latest : newest earlier run of the same topic that has the needed files
# <run_id> : a specific run (see `research-team runs`), whatever its topic
RESEARCH_REUSE_FROM=latest

# --- A2A server (research-team a2a) ---------------------------------------------
# RESEARCH_A2A_TOKEN=            # if set, every request except the agent card needs Authorization: Bearer <token>
# RESEARCH_A2A_PUBLIC_URL=       # URL advertised in the agent card when behind a proxy

# CrewAI telemetry off
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
